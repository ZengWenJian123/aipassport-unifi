# UniFi API key stays on this computer/NAS/DGX Spark. Never copy it to Passport.
UNIFI_API_KEY=replace-me
UNIFI_API_BASE_URL=https://api.ui.com
UNIFI_SITE_ID=
UNIFI_HOST_ID=
UNIFI_POLL_INTERVAL=30
# Default is loopback. Set 0.0.0.0 only on a trusted LAN and firewall port 8787.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8787
